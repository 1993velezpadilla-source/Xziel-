      "license_observation": "commercial-use-friendly Meta license; commercial checkpoint is separately gated and excludes military applications",
      "commercial_candidate": true,
      "notes": "Do not substitute the original non-commercial checkpoint for the commercial checkpoint."
    },
    {
      "id": "grounding_dino",
      "name": "Grounding DINO",
      "role": ["open_vocabulary_detection", "language_grounding"],
      "url": "https://github.com/IDEA-Research/GroundingDINO",
      "license_observation": "Apache-2.0 repository",
      "commercial_candidate": true,
      "notes": "Use as one proposal layer, not a closed ontology or sole authority."
    },
    {
      "id": "sam2",
      "name": "Meta SAM 2",
      "role": ["promptable_segmentation", "video_tracking"],
      "url": "https://github.com/facebookresearch/sam2",
      "license_observation": "Apache-2.0 package metadata; review checkpoint/dependency notices before shipping",
      "commercial_candidate": true,
      "notes": "Pairs naturally with open-vocabulary detectors for masks and temporal tracking."
    },
    {
      "id": "clay",
      "name": "Clay Foundation Model",
      "role": ["earth_observation", "remote_sensing_embeddings"],
      "url": "https://github.com/Clay-foundation/model",
      "license_observation": "Apache-2.0 code and trained model weights",
      "commercial_candidate": true,
      "notes": "Geospatial imagery specialist; not a replacement for ground-level scene understanding."
    }
  ],
