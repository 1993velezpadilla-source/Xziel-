  "packagePolicy": {
    "acceptedInputs": [
      "folder",
      "zip"
    ],
    "preserveSourceBytes": true,
    "deterministicInventory": true,
    "contentHash": "sha256",
    "rejectUnsafeZipPaths": true,
    "rejectZeroByteFiles": true,
    "rejectCasePathCollisions": true,
    "rejectUnresolvedAssetReferences": true,
    "rejectAmbiguousAssetReferences": true,
    "noSilentFallbacks": true,
    "noUnrelatedAssetSubstitution": true
  }
