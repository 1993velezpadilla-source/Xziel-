      "license_observation": "code Apache-2.0; facebook/map-anything-apache checkpoint Apache-2.0",
      "commercial_candidate": true,
      "notes": "Prefer the Apache checkpoint for commercial evaluation. The higher-performing default checkpoint is separately CC-BY-NC."
    },
    {
      "id": "vggt_commercial",
      "name": "Meta VGGT-1B-Commercial",
      "role": ["camera", "depth", "point_maps", "point_tracks", "multi_view_geometry"],
