{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xziel-match-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOMS",
        "class_name": "MatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
