{
  "schema": 1,
  "id": "hayuya_universal_game_design_brain_v1",
  "purpose": "Give HAYUYA Map broad game-space reasoning beyond any one franchise or genre. These are abstract clean-room design patterns, not copied layouts.",
  "principles": [
    "Design the player experience graph before decorative geometry.",
    "Every authored space must justify itself through navigation, combat, exploration, story, puzzle, economy, social play, spectacle, traversal, ambience, or technical streaming value.",
    "The same geometry may serve several systems, but no system may silently destroy the readability of another.",
    "Treat player routes, AI routes, sight lines, sound propagation, encounter pressure, landmarks, pacing and streaming as coupled graphs.",
    "Generate multiple layout hypotheses and solve/test them before expensive art generation.",
    "Use genre patterns as constraints and priors, never as a closed taxonomy.",
    "Prefer measurable constraints plus human-editable intent over one opaque generative score."
  ],
