  "worldConsistencyQuestions": [
    "What supports this structure and where does the load plausibly go?",
    "How does a person enter, circulate, service and leave this place?",
    "Where does rainwater go?",
    "Where do power, water, drainage and communication systems plausibly run?",
    "Why is this vegetation growing here and not there?",
    "How would age, moisture, use and damage change each material?",
    "Can a new player infer where to go without a HUD arrow?",
    "What can the player hear through this door, floor, wall or open window?",
    "Can enemies and co-op players actually traverse every intended route?",
    "Can the map stream on mobile without changing the authored experience?",
    "Does monetization disappear cleanly without changing gameplay or leaving empty holes?"
  ],
  "truthPolicy": {
    "observed": "Directly supported by user/provider evidence.",
    "inferred": "Plausible hypothesis from geometry, semantics or domain rules.",
    "generated": "Authored creative choice.",
    "professionalSafety": "HAYUYA spatial plausibility is for game/world creation and must not be presented as real structural, civil, electrical, fire, accessibility or life-safety certification."
  }
