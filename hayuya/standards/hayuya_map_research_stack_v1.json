{
  "schema": 1,
  "purpose": "HAYUYA Map model/provider research shortlist. No entry becomes a shipping default without a fresh license/terms review.",
  "models": [
    {
      "id": "mapanything_apache",
      "name": "Meta MapAnything Apache checkpoint",
      "role": ["metric_3d", "camera", "depth", "multi_view_geometry", "registration"],
