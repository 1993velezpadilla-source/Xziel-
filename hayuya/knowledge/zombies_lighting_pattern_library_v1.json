  "stateComposition": {
    "power_off": [
      "use sparse practical pools and exterior spill",
      "keep critical floor and exits readable",
      "reserve darkness in noncritical depth",
      "preserve global landmark silhouette"
    ],
    "power_on": [
      "sequence activation by electrical or narrative circuit",
      "wake emissive machinery and audio together",
      "increase navigation clarity but retain local threat shadows",
      "allow newly active equipment to produce new movement/shadow cues"
    ],
    "special_round": [
      "change one or two dominant cues rather than recolor everything",
      "preserve exits, hazards and enemy silhouettes",
      "use recognizable pre-arrival environmental warning"
    ],
    "boss_or_finale": [
      "reuse previously taught hazard and lighting language",
      "increase focal contrast at the objective",
      "preserve player orientation under spectacle"
    ]
  },
